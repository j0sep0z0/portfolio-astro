---
import { getLangFromUrl, useTranslations } from "../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const groups = [
  {
    title: t("tech.frontend"),
    skills: ["React", "Next.js", "Expo", "Tailwind CSS"],
  },
  {
    title: t("tech.logic"),
    skills: ["TypeScript", "Redux Toolkit", "Zustand", "Zod"],
  },
  {
    title: t("tech.backend"),
    skills: ["Node.js", "Express.js", "MongoDB", "DynamoDB"],
  },
  {
    title: t("tech.devops"),
    skills: ["AWS", "Docker", "AI Integrations", "Git"],
  },
]
---

<section id="tech-ecosystem" class="flex min-h-screen w-full snap-start flex-col justify-center px-8 py-32 md:px-24">
  <div class="mx-auto w-full max-w-screen-2xl">
    <div class="mb-24 space-y-4">
      <p class="text-3xl font-black uppercase md:text-5xl">
        {t("tech.title")}
        <span class="text-lavender">{t("tech.accent")}</span>
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2  lg:grid-cols-4">
      {
        groups.map((group) => (
          <div class="border-lavender/30 md:border-carbon-light md:hover:border-lavender group space-y-5 border p-8 transition-colors md:hover:bg-white/5">
            <div class="flex min-h-10 items-start">
              <h3 class="text-lavender text-xs font-black tracking-[0.2em] uppercase opacity-100 transition-opacity md:opacity-70 md:group-hover:opacity-100">
                {group.title}
              </h3>
            </div>
            <ul class="space-y-4">
              {group.skills.map((skill) => (
                <li class="flex items-center gap-3 text-sm font-light tracking-wide text-gray-200 transition-colors md:text-gray-400 md:group-hover:text-gray-200">
                  <div class="bg-lavender h-1.5 w-1.5 shrink-0 opacity-100 shadow-[0_0_8px_rgba(180,151,214,0.3)] transition-all md:opacity-40 md:group-hover:scale-110 md:group-hover:opacity-100" />
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
