---
import { getLangFromUrl, useTranslations } from "../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const projects = [
  {
    title: t("projects.rkive.title"),
    category: t("projects.rkive.category"),
    description: t("projects.rkive.desc"),
    tags: ["Expo", "Next.js", "Node.js", "Express", "AWS", "AI Models"],
    image: "/projects/rkive.png",
    alt: t("projects.rkive.alt"),
    link: "https://rkiveai.com/",
  },
  {
    title: t("projects.reffindr.title"),
    category: t("projects.reffindr.category"),
    description: t("projects.reffindr.desc"),
    tags: ["React", "Vite", "Node.js", "Express", "Redux", "Tailwind"],
    image: "/projects/reffindr.png",
    alt: t("projects.reffindr.alt"),
    link: "https://github.com/IgrowkerTraining/i004-reffindr-back-nodejs",
  },
  {
    title: t("projects.gopass.title"),
    category: t("projects.gopass.category"),
    description: t("projects.gopass.desc"),
    tags: ["React", "Vite", "Tailwind", "Redux"],
    image: "/projects/gopass.png",
    alt: t("projects.gopass.alt"),
    link: "https://github.com/IgrowkerTraining/i003-gopass-front",
  },
]
---

<section
  id="projects"
  class="bg-carbon-deep flex min-h-screen w-full snap-start flex-col justify-center px-8 py-32 md:px-24"
>
  <div class="mx-auto w-full max-w-screen-2xl">
    <div class="mb-24 flex items-end justify-between">
      <div class="space-y-4">
        <p class="text-3xl font-black uppercase md:text-5xl">
          {t("projects.title")}
          <br />
          <span class="text-lavender">{t("projects.accent")}</span>
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group hover:border-lavender/40 relative flex flex-col border border-transparent p-6 transition-all duration-500 hover:bg-white/5"
          >
            <div class="relative mb-6 aspect-video overflow-hidden border border-white/10 transition-colors duration-500 group-hover:border-transparent">
              <img
                src={project.image}
                alt={project.alt}
                class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
              />
              <div class="bg-lavender absolute inset-0 opacity-0 mix-blend-multiply transition-opacity duration-500 group-hover:opacity-20" />
            </div>

            <div class="space-y-3">
              <div class="flex items-start justify-between">
                <span class="text-lavender text-[10px] font-black tracking-widest uppercase">{project.category}</span>
                <div class="bg-carbon-light group-hover:bg-lavender h-2 w-2 rounded-full transition-colors" />
              </div>
              <h3 class="text-xl font-black tracking-tight uppercase">{project.title}</h3>
              <p class="line-clamp-2 text-sm text-gray-400">{project.description}</p>

              <div class="flex flex-wrap gap-2 pt-4">
                {project.tags.map((tag) => (
                  <span class="border-carbon-light group-hover:border-lavender/30 border px-2 py-1 text-[9px] font-bold tracking-widest text-gray-500 uppercase group-hover:text-gray-300">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
