---
import { languages } from "../i18n/ui"
import { getLangFromUrl } from "../i18n/utils"

const lang = getLangFromUrl(Astro.url)
---

<div class="fixed top-8 right-8 z-50 flex gap-2">
  {
    Object.entries(languages).map(([l, label]) => (
      <a
        href={`/${l}/`}
        class:list={[
          "border px-3 py-1 text-[10px] font-black tracking-[0.2em] uppercase transition-all duration-300",
          lang === l
            ? "bg-lavender text-carbon-deep border-lavender"
            : "border-carbon-light text-gray-500 hover:border-white hover:text-white",
        ]}
      >
        {l}
      </a>
    ))
  }
</div>
