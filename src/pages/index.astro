---
export const prerender = false

const savedLocale = Astro.cookies.get("astro-locale")?.value
const preferredLocale = Astro.preferredLocale

if (savedLocale === "es" || savedLocale === "en") {
  return Astro.redirect(`/${savedLocale}/`)
}
if (preferredLocale && preferredLocale.startsWith("es")) {
  return Astro.redirect("/es/")
}

return Astro.redirect("/en/")
---
