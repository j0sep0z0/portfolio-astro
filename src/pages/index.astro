---
import Layout from "../layouts/Layout.astro"

const name = "Jose"
const title = "Personal Portfolio · Astro"
const description = "Welcome to my personal portfolio. Built with Astro and Tailwind CSS."

const socialLinks = [
  { href: "#projects", text: "View Projects", primary: true },
  { href: "#contact", text: "Contact Me", primary: false },
]
---

<Layout title={title}>
  <main class="flex min-h-screen flex-col items-center justify-center p-24 text-center">
    <h1 class="mb-4 bg-gradient-to-r from-blue-400 to-purple-600 bg-clip-text text-6xl font-bold text-transparent">
      Hello, I'm <span class="text-white">{name}</span>! 👋
    </h1>
    <p class="mb-8 max-w-2xl text-xl text-gray-300">
      {description}
    </p>

    <div class="flex gap-4">
      {
        socialLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-lg px-6 py-3 font-bold transition-colors",
              {
                "bg-blue-600 text-white hover:bg-blue-700": link.primary,
                "border border-white/20 text-white hover:bg-white/10": !link.primary,
              },
            ]}
          >
            {link.text}
          </a>
        ))
      }
    </div>
  </main>
</Layout>
